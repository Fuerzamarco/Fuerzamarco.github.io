# Copia este archivo a .env y rellena los valores.
# .env NO se sube a git (está en .gitignore).

# --- WordPress (Fase 4) ---
# URL base del sitio, sin barra final.
WP_BASE_URL=https://tu-sitio.com
# Usuario de WordPress.
WP_USERNAME=
# Application Password generado desde WP-Admin → Usuarios → Perfil.
# (NO uses la contraseña normal del usuario.)
WP_APP_PASSWORD=

# --- Claude Agent SDK ---
# Normalmente no necesitas nada aquí: el SDK reusa la sesión de Claude Code.
# Si en algún momento decides separarlo, este es el lugar.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Otros ---
# Idioma por defecto para los artículos generados.
DEFAULT_LANGUAGE=es
