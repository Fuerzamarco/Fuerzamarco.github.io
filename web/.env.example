# Astro env vars (Vite los lee desde web/.env).
# Variables con prefijo PUBLIC_ quedan expuestas al cliente.

# URL pública del sitio. Afecta canonical, OG, sitemap, RSS, ads.txt.
# En producción, ponla a tu dominio real con https://.
PUBLIC_SITE_URL=https://tu-sitio.com

# AdSense publisher ID, sin el prefijo "pub-".
# Vacío:
#   - <AdSlot /> renderiza nada (no-op)
#   - No se carga adsbygoogle.js
#   - /ads.txt devuelve un placeholder comentado
# Con valor:
#   - <AdSlot /> renderiza <ins class="adsbygoogle">
#   - Base.astro carga adsbygoogle.js (async)
#   - /ads.txt emite la línea válida
PUBLIC_ADSENSE_PUBLISHER_ID=

# Google Search Console site verification.
# Copia solo el valor del atributo content="..." que da Search Console
# al elegir "HTML tag" como método de verificación.
# Vacío: no se emite el meta tag (no-op).
# Con valor: <meta name="google-site-verification" content="..."> en <head>.
PUBLIC_GOOGLE_SITE_VERIFICATION=
