---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Migas de pan" class="text-sm">
  <ol class="flex flex-wrap items-center gap-2 text-slate-500">
    {items.map((crumb, i) => (
      <li class="flex items-center gap-2">
        {crumb.href ? (
          <a
            href={crumb.href}
            class="transition-colors duration-150 hover:text-indigo-700"
          >
            {crumb.label}
          </a>
        ) : (
          <span class="text-slate-700" aria-current="page">{crumb.label}</span>
        )}
        {i < items.length - 1 && (
          <span aria-hidden="true" class="text-slate-300">/</span>
        )}
      </li>
    ))}
  </ol>
</nav>
