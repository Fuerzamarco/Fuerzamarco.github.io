---
import { SITE_NAME, NAV_ITEMS } from '../config/site';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="border-b border-slate-200">
  <div class="mx-auto max-w-6xl px-6 py-6 flex items-center justify-between">
    <a
      href="/"
      class="inline-flex items-center gap-2.5 text-lg font-bold tracking-tight text-slate-950 hover:text-indigo-700 transition-colors duration-150"
    >
      <span aria-hidden="true" class="block h-5 w-[3px] bg-indigo-600"></span>
      {SITE_NAME}
    </a>
    <nav aria-label="Principal" class="flex items-center gap-x-6 text-sm">
      {NAV_ITEMS.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'transition-colors duration-150',
              active
                ? 'text-slate-950 font-medium'
                : 'text-slate-500 hover:text-indigo-700',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
