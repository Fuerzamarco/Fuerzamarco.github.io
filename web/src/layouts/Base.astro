---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_NAME } from '../config/site';
import {
  buildOrganizationSchema,
  buildWebsiteSchema,
} from '../lib/schema';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = canonicalPath
  ? new URL(canonicalPath, Astro.site).toString()
  : Astro.url.toString();

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ctx = { siteUrl, siteName: SITE_NAME };
const orgSchema = buildOrganizationSchema(ctx);
const websiteSchema = buildWebsiteSchema(ctx);

const ADSENSE_PUBLISHER_ID =
  import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID || '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={`${siteUrl}/rss.xml`}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <JsonLd data={orgSchema} />
    <JsonLd data={websiteSchema} />
    {ADSENSE_PUBLISHER_ID && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-${ADSENSE_PUBLISHER_ID}`}
        crossorigin="anonymous"
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
